{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts", ".mdsrc/**/*"]
}